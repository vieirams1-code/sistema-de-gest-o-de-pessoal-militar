{
  "name": "ModeloNotaColetiva",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "maxLength": 150
    },
    "tipo": {
      "type": "string",
      "maxLength": 150
    },
    "cabecalho": {
      "type": "string",
      "maxLength": 12000
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome",
    "tipo",
    "cabecalho"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}