{
  "name": "AuditoriaPermissoesExecucao",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "Identificador est\u00e1vel da execu\u00e7\u00e3o, ex.: AUD-PERM-2026-001"
    },
    "titulo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PLANEJADA",
        "EM_ANDAMENTO",
        "PAUSADA",
        "CONCLUIDA",
        "CANCELADA"
      ],
      "default": "PLANEJADA"
    },
    "fase_atual": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "escopo_descricao": {
      "type": "string"
    },
    "metodologia": {
      "type": "string"
    },
    "checkpoint_base": {
      "type": "string"
    },
    "iniciado_em": {
      "type": "string",
      "format": "date-time"
    },
    "concluido_em": {
      "type": "string",
      "format": "date-time"
    },
    "total_achados": {
      "type": "number",
      "default": 0
    },
    "total_p0": {
      "type": "number",
      "default": 0
    },
    "total_p1": {
      "type": "number",
      "default": 0
    },
    "total_p2": {
      "type": "number",
      "default": 0
    },
    "total_p3": {
      "type": "number",
      "default": 0
    },
    "total_corrigidos": {
      "type": "number",
      "default": 0
    },
    "total_retestados": {
      "type": "number",
      "default": 0
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "codigo",
    "titulo",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}