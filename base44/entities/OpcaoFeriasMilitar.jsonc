{
  "name": "OpcaoFeriasMilitar",
  "type": "object",
  "title": "Op\u00e7\u00e3o e Escala\u00e7\u00e3o de F\u00e9rias do Militar",
  "description": "Registro das 3 op\u00e7\u00f5es de meses/datas do militar, workflow de aprova\u00e7\u00e3o em 2 camadas e gera\u00e7\u00e3o de f\u00e9rias.",
  "properties": {
    "campanha_id": {
      "type": "string"
    },
    "plano_ferias_institucional_id": {
      "type": "string",
      "description": "Plano de F\u00e9rias que consolida esta resposta"
    },
    "ano_referencia": {
      "type": "number"
    },
    "militar_id": {
      "type": "string"
    },
    "militar_nome": {
      "type": "string"
    },
    "militar_posto": {
      "type": "string"
    },
    "militar_matricula": {
      "type": "string"
    },
    "militar_quadro": {
      "type": "string"
    },
    "lotacao_id": {
      "type": "string"
    },
    "lotacao_nome": {
      "type": "string"
    },
    "periodo_aquisitivo_id": {
      "type": "string"
    },
    "periodo_inicio": {
      "type": "string"
    },
    "periodo_fim": {
      "type": "string"
    },
    "dias_direito": {
      "type": "number",
      "default": 30
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "1_ETAPA_30",
        "2_ETAPAS_15",
        "3_ETAPAS_10",
        "CUSTOM"
      ],
      "default": "2_ETAPAS_15"
    },
    "opcao_1_meses": {
      "type": "string"
    },
    "opcao_1_detalhes": {
      "type": "string"
    },
    "opcao_2_meses": {
      "type": "string"
    },
    "opcao_2_detalhes": {
      "type": "string"
    },
    "opcao_3_meses": {
      "type": "string"
    },
    "opcao_3_detalhes": {
      "type": "string"
    },
    "data_envio_militar": {
      "type": "string",
      "format": "date-time"
    },
    "origem_resposta": {
      "type": "string",
      "enum": [
        "MILITAR",
        "ADMINISTRATIVA"
      ],
      "default": "MILITAR",
      "description": "MILITAR: enviada pelo pr\u00f3prio militar no portal. ADMINISTRATIVA: registrada pelo gestor para militar que n\u00e3o respondeu no prazo."
    },
    "nao_gozo_no_plano": {
      "type": "boolean",
      "default": false,
      "description": "Registro formal de que o militar optou por n\u00e3o gozar f\u00e9rias neste plano. Situa\u00e7\u00e3o pr\u00f3pria, distinta de 'n\u00e3o respondeu no prazo'. O per\u00edodo aquisitivo permanece pendente para defini\u00e7\u00e3o do gestor."
    },
    "justificativa_nao_gozo": {
      "type": "string",
      "description": "Justificativa informada pelo militar ao optar por n\u00e3o gozar f\u00e9rias neste plano."
    },
    "data_nao_gozo": {
      "type": "string",
      "format": "date-time",
      "description": "Auditoria \u2014 data/hora do registro da op\u00e7\u00e3o de n\u00e3o gozo."
    },
    "nao_respondeu_no_prazo": {
      "type": "boolean",
      "default": false,
      "description": "Registro formal de que o militar n\u00e3o respondeu dentro do prazo da campanha. Permite a defini\u00e7\u00e3o administrativa das f\u00e9rias."
    },
    "justificativa_administrativa": {
      "type": "string",
      "description": "Justificativa do gestor ao registrar a pend\u00eancia de resposta."
    },
    "registrado_por_email": {
      "type": "string",
      "description": "Auditoria \u2014 e-mail do gestor que registrou a pend\u00eancia."
    },
    "data_registro_administrativo": {
      "type": "string",
      "format": "date-time",
      "description": "Auditoria \u2014 data/hora do registro da pend\u00eancia."
    },
    "status_camada_1": {
      "type": "string",
      "enum": [
        "Pendente",
        "Opcao_1_Aprovada",
        "Opcao_2_Aprovada",
        "Opcao_3_Aprovada",
        "Ajustado_Pelo_Gestor",
        "Homologado_Unidade",
        "Pendente_Reanalise"
      ],
      "default": "Pendente",
      "description": "Pendente_Reanalise indica que o per\u00edodo aquisitivo original j\u00e1 est\u00e1 comprometido por f\u00e9rias existentes e precisa de reatribui\u00e7\u00e3o manual do gestor."
    },
    "decisao_camada_1_opcao": {
      "type": "string"
    },
    "decisao_camada_1_meses": {
      "type": "string"
    },
    "decisao_camada_1_detalhes": {
      "type": "string"
    },
    "gestor_unidade_id": {
      "type": "string"
    },
    "gestor_unidade_nome": {
      "type": "string"
    },
    "data_decisao_camada_1": {
      "type": "string",
      "format": "date-time"
    },
    "justificativa_ajuste_gestor": {
      "type": "string"
    },
    "status_camada_2": {
      "type": "string",
      "enum": [
        "Pendente",
        "Homologado_Superior",
        "Rejeitado_Para_Revisao"
      ],
      "default": "Pendente"
    },
    "superior_homologador_id": {
      "type": "string"
    },
    "superior_homologador_nome": {
      "type": "string"
    },
    "data_homologacao_superior": {
      "type": "string",
      "format": "date-time"
    },
    "observacao_superior": {
      "type": "string"
    },
    "gerado_ferias_efetivas": {
      "type": "boolean",
      "default": false
    },
    "data_geracao_ferias": {
      "type": "string",
      "format": "date-time"
    },
    "ferias_ids_geradas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ano_referencia",
    "militar_id",
    "periodo_aquisitivo_id"
  ]
}