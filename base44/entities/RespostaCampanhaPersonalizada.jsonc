{
  "name": "RespostaCampanhaPersonalizada",
  "type": "object",
  "title": "Resposta de Campanha e Formul\u00e1rio do Portal",
  "description": "Armazena as respostas preenchidas pelos militares em campanhas de formul\u00e1rios din\u00e2micos e devolu\u00e7\u00e3o de documentos assinados.",
  "properties": {
    "campanha_id": {
      "type": "string",
      "description": "ID da CampanhaPortal associada"
    },
    "militar_id": {
      "type": "string",
      "description": "ID do militar que respondeu"
    },
    "militar_nome": {
      "type": "string"
    },
    "militar_matricula": {
      "type": "string"
    },
    "militar_posto": {
      "type": "string"
    },
    "militar_lotacao": {
      "type": "string"
    },
    "militar_celular": {
      "type": "string"
    },
    "respostas_json": {
      "type": "string",
      "description": "JSON com as respostas de cada campo do formul\u00e1rio { [campo_id]: valor }"
    },
    "arquivos_anexados_json": {
      "type": "string",
      "description": "JSON com os arquivos anexados por campo { [campo_id]: { url, nome, tamanho } }"
    },
    "arquivo_devolucao_url": {
      "type": "string",
      "description": "URL do arquivo assinado devolvido pelo militar (campanhas de assinatura)"
    },
    "arquivo_devolucao_nome": {
      "type": "string",
      "description": "Nome do arquivo assinado devolvido"
    },
    "resposta_texto_geral": {
      "type": "string",
      "description": "Texto/justificativa geral fornecida pelo militar"
    },
    "termo_aceite": {
      "type": "boolean",
      "default": false,
      "description": "Confirma\u00e7\u00e3o do termo de ci\u00eancia ou declara\u00e7\u00e3o"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Enviado",
        "Homologado",
        "Rejeitado",
        "Pendente_Correcao"
      ],
      "default": "Enviado"
    },
    "observacao_gestor": {
      "type": "string",
      "description": "Despacho ou observa\u00e7\u00e3o do gestor/RH"
    },
    "homologado_por_nome": {
      "type": "string"
    },
    "data_homologacao": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "campanha_id",
    "militar_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}