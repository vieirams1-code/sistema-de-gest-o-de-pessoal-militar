{
  "name": "ProcedimentoPrazoHistorico",
  "type": "object",
  "title": "Hist\u00f3rico de Prazos do Procedimento",
  "description": "Trilha dos prazos do procedimento (instaura\u00e7\u00e3o e prorroga\u00e7\u00f5es), base para as publica\u00e7\u00f5es de prazo.",
  "properties": {
    "procedimento_id": {
      "type": "string",
      "default": ""
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Instaura\u00e7\u00e3o",
        "Prorroga\u00e7\u00e3o",
        "Solu\u00e7\u00e3o"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green"
      ],
      "default": "Prorroga\u00e7\u00e3o"
    },
    "dias": {
      "type": "number",
      "default": 0
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "default": ""
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "default": ""
    },
    "motivo": {
      "type": "string",
      "default": ""
    },
    "criado_por_email": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "procedimento_id",
    "tipo"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}