{
  "name": "ProcedimentoEnvolvido",
  "type": "object",
  "title": "Envolvido do Procedimento",
  "description": "Militares vinculados a um procedimento administrativo, com o papel exercido (investigado, testemunha, etc.).",
  "properties": {
    "procedimento_id": {
      "type": "string",
      "default": ""
    },
    "militar_id": {
      "type": "string",
      "default": ""
    },
    "nome": {
      "type": "string",
      "default": ""
    },
    "posto": {
      "type": "string",
      "default": ""
    },
    "quadro": {
      "type": "string",
      "default": ""
    },
    "matricula": {
      "type": "string",
      "default": ""
    },
    "papel": {
      "type": "string",
      "enum": [
        "Investigado",
        "Testemunha",
        "Encarregado",
        "Autoridade",
        "Outro"
      ],
      "enumColors": [
        "red",
        "blue",
        "purple",
        "yellow",
        "gray"
      ],
      "default": "Investigado"
    },
    "observacao": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "procedimento_id",
    "papel"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}