{
  "name": "MembroGrupoEfetivo",
  "type": "object",
  "title": "Membro de grupo do efetivo",
  "description": "V\u00ednculo versionado entre militar e GrupoEfetivo, com validade e origem.",
  "properties": {
    "grupo_id": {
      "type": "string",
      "description": "ID do GrupoEfetivo."
    },
    "militar_id": {
      "type": "string",
      "description": "ID do Militar."
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Indica se o v\u00ednculo est\u00e1 ativo."
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio da validade do v\u00ednculo."
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim da validade do v\u00ednculo, quando aplic\u00e1vel."
    },
    "origem": {
      "type": "string",
      "enum": [
        "MANUAL",
        "DERIVADO",
        "IMPORTADO"
      ],
      "default": "MANUAL",
      "description": "Origem do v\u00ednculo."
    },
    "observacao": {
      "type": "string",
      "description": "Justificativa ou observa\u00e7\u00e3o do v\u00ednculo."
    }
  },
  "required": [
    "grupo_id",
    "militar_id",
    "ativo"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}