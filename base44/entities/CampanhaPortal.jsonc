{
  "name": "CampanhaPortal",
  "type": "object",
  "title": "Campanha de A\u00e7\u00e3o do Portal do Militar",
  "description": "Orquestra\u00e7\u00e3o de campanhas de f\u00e9rias e atualiza\u00e7\u00e3o cadastral lan\u00e7adas pelos gestores por escopo e prazo.",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "PLANO_FERIAS",
        "ATUALIZACAO_CADASTRAL",
        "CONFERENCIA_GERAL",
        "ASSINATURA_DOCUMENTO",
        "FORMULARIO_DINAMICO"
      ],
      "description": "Tipo da a\u00e7\u00e3o atribu\u00edda ao militar"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da campanha (ex: Plano Anual de F\u00e9rias 2027)"
    },
    "ano_referencia": {
      "type": "number",
      "description": "Ano de refer\u00eancia (ex: 2027)"
    },
    "plano_ferias_institucional_id": {
      "type": "string",
      "description": "ID do PlanoFeriasInstitucional ao qual esta campanha de f\u00e9rias pertence. Opcional para compatibilidade com campanhas legadas."
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Aberta_Coleta",
        "Em_Homologacao",
        "Homologada",
        "Encerrada"
      ],
      "default": "Aberta_Coleta"
    },
    "config_formulario": {
      "type": "string",
      "description": "JSON com a defini\u00e7\u00e3o dos campos e perguntas do formul\u00e1rio din\u00e2mico"
    },
    "arquivo_modelo_url": {
      "type": "string",
      "description": "URL do arquivo modelo disponibilizado pelo gestor para download"
    },
    "arquivo_modelo_nome": {
      "type": "string",
      "description": "Nome original do arquivo modelo disponibilizado"
    },
    "exigir_devolucao_arquivo": {
      "type": "boolean",
      "default": false,
      "description": "Se o militar \u00e9 obrigado a enviar um arquivo assinado/comprovante"
    },
    "texto_termo_aceite": {
      "type": "string",
      "description": "Texto do termo de declara\u00e7\u00e3o/ci\u00eancia a ser marcado pelo militar"
    },
    "tipo_escopo": {
      "type": "string",
      "enum": [
        "TODOS",
        "UNIDADES",
        "SELECAO_MILITARES",
        "QUADROS"
      ],
      "default": "TODOS",
      "description": "Forma de sele\u00e7\u00e3o do p\u00fablico-alvo"
    },
    "escopo_unidades_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IDs das unidades/lota\u00e7\u00f5es inclu\u00eddas"
    },
    "escopo_unidades_nomes": {
      "type": "string",
      "description": "Nomes das unidades para exibi\u00e7\u00e3o resumida"
    },
    "escopo_militares_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IDs de militares espec\u00edficos inclu\u00eddos"
    },
    "escopo_quadros": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da campanha"
    },
    "data_fim_militar": {
      "type": "string",
      "format": "date",
      "description": "Prazo limite para o militar responder no portal"
    },
    "data_fim_unidade": {
      "type": "string",
      "format": "date",
      "description": "Prazo para homologa\u00e7\u00e3o pelos gestores da unidade"
    },
    "instrucoes": {
      "type": "string",
      "description": "Orienta\u00e7\u00f5es aos militares exibidas no portal"
    },
    "config_regras": {
      "type": "string",
      "description": "JSON com regras personalizadas da campanha"
    },
    "total_publico_alvo": {
      "type": "number",
      "default": 0
    },
    "total_respondidos": {
      "type": "number",
      "default": 0
    },
    "total_pendentes": {
      "type": "number",
      "default": 0
    },
    "criado_por_nome": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "status"
  ]
}