{
  "name": "CampanhaPortal",
  "type": "object",
  "title": "Campanha de A\u00e7\u00e3o do Portal do Militar",
  "description": "Orquestra\u00e7\u00e3o de campanhas de f\u00e9rias e atualiza\u00e7\u00e3o cadastral lan\u00e7adas pelos gestores por escopo e prazo.",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "PLANO_FERIAS",
        "ATUALIZACAO_CADASTRAL",
        "CONFERENCIA_GERAL",
        "ASSINATURA_DOCUMENTO",
        "FORMULARIO_DINAMICO"
      ],
      "description": "Tipo da a\u00e7\u00e3o atribu\u00edda ao militar"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da campanha"
    },
    "ano_referencia": {
      "type": "number",
      "description": "Ano de refer\u00eancia"
    },
    "plano_ferias_institucional_id": {
      "type": "string",
      "description": "Plano de F\u00e9rias Institucional ao qual esta campanha pertence"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Aberta_Coleta",
        "Em_Homologacao",
        "Homologada",
        "Encerrada",
        "Arquivada",
        "Desativada"
      ],
      "default": "Aberta_Coleta"
    },
    "config_formulario": {
      "type": "string",
      "description": "JSON com a defini\u00e7\u00e3o do formul\u00e1rio"
    },
    "arquivo_modelo_url": {
      "type": "string"
    },
    "arquivo_modelo_nome": {
      "type": "string"
    },
    "exigir_devolucao_arquivo": {
      "type": "boolean",
      "default": false
    },
    "texto_termo_aceite": {
      "type": "string"
    },
    "tipo_escopo": {
      "type": "string",
      "enum": [
        "TODOS",
        "UNIDADES",
        "SEM_ESCOPO",
        "SELECAO_MILITARES",
        "QUADROS",
        "UNIDADES_E_GRUPOS"
      ],
      "default": "TODOS"
    },
    "escopo_unidades_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das lota\u00e7\u00f5es inclu\u00eddas; vazio em campanhas somente por grupo"
    },
    "escopo_unidades_nomes": {
      "type": "string"
    },
    "escopo_militares_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de militares inclu\u00eddos"
    },
    "escopo_militares_excluidos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de militares exclu\u00eddos explicitamente"
    },
    "escopo_grupos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de grupos reutiliz\u00e1veis inclu\u00eddos; podem ser usados sozinhos ou combinados com a lota\u00e7\u00e3o"
    },
    "escopo_grupos_nomes": {
      "type": "string"
    },
    "escopo_grupos_excluidos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de grupos exclu\u00eddos explicitamente"
    },
    "escopo_quadros": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim_militar": {
      "type": "string",
      "format": "date"
    },
    "hora_fim_militar": {
      "type": "string",
      "format": "time",
      "description": "Hora limite vigente para resposta, no fuso America/Campo_Grande."
    },
    "data_fim_militar_original": {
      "type": "string",
      "format": "date",
      "description": "Primeiro prazo registrado antes de qualquer prorroga\u00e7\u00e3o."
    },
    "hora_fim_militar_original": {
      "type": "string",
      "format": "time",
      "description": "Hora do primeiro prazo, quando dispon\u00edvel."
    },
    "encerrada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora t\u00e9cnica do encerramento autom\u00e1tico ou manual."
    },
    "quantidade_prorrogacoes": {
      "type": "number",
      "default": 0
    },
    "data_fim_unidade": {
      "type": "string",
      "format": "date"
    },
    "instrucoes": {
      "type": "string"
    },
    "config_regras": {
      "type": "string"
    },
    "total_publico_alvo": {
      "type": "number",
      "default": 0
    },
    "total_respondidos": {
      "type": "number",
      "default": 0
    },
    "total_pendentes": {
      "type": "number",
      "default": 0
    },
    "criado_por_nome": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tipo",
    "titulo",
    "status"
  ]
}