{
  "name": "EmpenhoMilitar",
  "type": "object",
  "title": "Militar empenhado",
  "description": "V\u00ednculo entre miss\u00e3o e militar, com impacto expl\u00edcito na disponibilidade.",
  "properties": {
    "empenho_operacional_id": {
      "type": "string"
    },
    "militar_id": {
      "type": "string"
    },
    "militar_nome": {
      "type": "string"
    },
    "papel": {
      "type": "string"
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "impacto_disponibilidade": {
      "type": "string",
      "enum": [
        "INDISPONIVEL",
        "DISPONIVEL_COM_RESTRICAO"
      ],
      "default": "INDISPONIVEL"
    },
    "status": {
      "type": "string",
      "enum": [
        "EMPENHADO",
        "LIBERADO",
        "CANCELADO"
      ],
      "default": "EMPENHADO"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "empenho_operacional_id",
    "militar_id",
    "data_inicio",
    "data_fim",
    "impacto_disponibilidade"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}