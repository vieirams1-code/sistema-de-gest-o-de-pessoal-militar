{
  "name": "Militar",
  "type": "object",
  "properties": {
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do militar"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto do militar"
    },
    "status_cadastro": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo"
    },
    "situacao_militar": {
      "type": "string",
      "enum": [
        "Ativa",
        "Reserva Remunerada",
        "Reformado",
        "Designado",
        "Convocado"
      ],
      "default": "Ativa"
    },
    "funcao": {
      "type": "string"
    },
    "lotacao": {
      "type": "string"
    },
    "condicao": {
      "type": "string",
      "enum": [
        "Efetivo",
        "Adido",
        "Agregado",
        "Cedido",
        "À Disposição",
        "LTIP"
      ]
    },
    "destino": {
      "type": "string",
      "description": "Campo legado — substituído por condicao_origem_destino. Mantido para compatibilidade."
    },
    "condicao_movimento": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Movimento da condição do militar. 'entrada' indica que veio de outro órgão; 'saida' indica que foi para outro órgão. Não se aplica quando condicao = Efetivo ou LTIP."
    },
    "condicao_origem_destino": {
      "type": "string",
      "description": "Texto livre da origem (quando movimento = entrada) ou destino (quando movimento = saida) da condição. Não se aplica quando condicao = Efetivo ou LTIP."
    },
    "ltip_data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de início da LTIP (Licença para Tratamento de Interesse Particular). Obrigatória quando condicao = LTIP."
    },
    "ltip_data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de retorno/fim da LTIP. Obrigatória quando condicao = LTIP."
    },
    "nome_guerra": {
      "type": "string"
    },
    "matricula": {
      "type": "string"
    },
    "posto_graduacao": {
      "type": "string",
      "enum": [
        "Coronel",
        "Tenente Coronel",
        "Major",
        "Capitão",
        "1º Tenente",
        "2º Tenente",
        "Aspirante",
        "Subtenente",
        "1º Sargento",
        "2º Sargento",
        "3º Sargento",
        "Cabo",
        "Soldado"
      ]
    },
    "quadro": {
      "type": "string",
      "enum": [
        "QOBM",
        "QAOBM",
        "QOEBM",
        "QOSAU",
        "QBMP-1.a",
        "QBMP-1.b",
        "QBMP-2",
        "QPTBM",
        "QBMPT"
      ]
    },
    "data_inclusao": {
      "type": "string",
      "format": "date"
    },
    "comportamento": {
      "type": "string",
      "enum": [
        "Excepcional",
        "Ótimo",
        "Bom",
        "Insuficiente",
        "MAU"
      ],
      "default": "Bom"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Masculino",
        "Feminino"
      ]
    },
    "estado_civil": {
      "type": "string",
      "enum": [
        "Solteiro(a)",
        "Casado(a)",
        "Divorciado(a)",
        "Viúvo(a)",
        "União Estável"
      ]
    },
    "tipo_sanguineo": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-"
      ]
    },
    "religiao": {
      "type": "string"
    },
    "escolaridade": {
      "type": "string",
      "enum": [
        "Ensino Fundamental Incompleto",
        "Ensino Fundamental Completo",
        "Ensino Médio Incompleto",
        "Ensino Médio Completo",
        "Ensino Superior Incompleto",
        "Ensino Superior Completo",
        "Pós-Graduação",
        "Mestrado",
        "Doutorado"
      ]
    },
    "curso_superior": {
      "type": "string"
    },
    "pos_graduacao": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mestrado": {
      "type": "string"
    },
    "doutorado": {
      "type": "string"
    },
    "naturalidade": {
      "type": "string"
    },
    "naturalidade_uf": {
      "type": "string"
    },
    "nome_pai": {
      "type": "string"
    },
    "nome_mae": {
      "type": "string"
    },
    "rg": {
      "type": "string"
    },
    "orgao_expedidor_rg": {
      "type": "string"
    },
    "uf_rg": {
      "type": "string"
    },
    "cnh_categoria": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "AB",
        "C",
        "D",
        "E",
        "AC",
        "AD",
        "AE",
        "ACC"
      ]
    },
    "cnh_validade": {
      "type": "string",
      "format": "date"
    },
    "cnh_numero": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "banco": {
      "type": "string"
    },
    "agencia": {
      "type": "string"
    },
    "conta": {
      "type": "string"
    },
    "email_particular": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": "string"
    },
    "email_funcional": {
      "type": "string",
      "format": "email"
    },
    "altura": {
      "type": "number"
    },
    "peso": {
      "type": "number"
    },
    "etnia": {
      "type": "string",
      "enum": [
        "Branca",
        "Preta",
        "Parda",
        "Amarela",
        "Indígena"
      ]
    },
    "logradouro": {
      "type": "string"
    },
    "numero_endereco": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "complemento": {
      "type": "string"
    },
    "habilidades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grupamento_id": {
      "type": "string",
      "description": "Campo legado — ID do grupamento ao qual o militar pertence"
    },
    "grupamento_nome": {
      "type": "string",
      "description": "Campo legado — Nome do grupamento (denormalizado)"
    },
    "subgrupamento_id": {
      "type": "string",
      "description": "Campo legado — ID do subgrupamento ao qual o militar pertence"
    },
    "subgrupamento_nome": {
      "type": "string",
      "description": "Campo legado — Nome do subgrupamento (denormalizado)"
    },
    "estrutura_id": {
      "type": "string",
      "description": "ID do nó da estrutura organizacional (Subgrupamento) ao qual o militar está lotado. Suporta os 3 níveis: Grupamento, Subgrupamento ou Unidade."
    },
    "estrutura_nome": {
      "type": "string",
      "description": "Nome do nó da estrutura (denormalizado)"
    },
    "estrutura_tipo": {
      "type": "string",
      "enum": [
        "Grupamento",
        "Subgrupamento",
        "Unidade"
      ],
      "description": "Tipo do nó da estrutura ao qual o militar está lotado"
    },
    "operacao_promocao_token": {
      "type": "string",
      "description": "Token de exclusão mútua de operação oficial. Campo interno.",
      "default": ""
    }
  },
  "required": [
    "nome_completo",
    "matricula"
  ]
}
