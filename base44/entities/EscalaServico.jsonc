{
  "name": "EscalaServico",
  "type": "object",
  "title": "Escala de servi\u00e7o",
  "description": "Per\u00edodo operacional da sargentea\u00e7\u00e3o em regime 24x72.",
  "properties": {
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "ciclo": {
      "type": "string",
      "enum": [
        "24X72"
      ],
      "default": "24X72"
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "PUBLICADA",
        "ENCERRADA",
        "CANCELADA"
      ],
      "default": "RASCUNHO"
    },
    "quartel_posto_id": {
      "type": "string"
    },
    "ala_grupo_id": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "data_inicio",
    "data_fim",
    "ciclo",
    "status"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}