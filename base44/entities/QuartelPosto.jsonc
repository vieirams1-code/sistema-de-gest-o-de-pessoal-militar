{
  "name": "QuartelPosto",
  "type": "object",
  "title": "Quartel ou posto",
  "description": "Unidade f\u00edsica usada pela sargentea\u00e7\u00e3o. Referencia a estrutura organizacional existente sem duplic\u00e1-la.",
  "properties": {
    "nome": {
      "type": "string"
    },
    "sigla": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "QUARTEL",
        "POSTO"
      ],
      "default": "QUARTEL"
    },
    "estrutura_id": {
      "type": "string"
    },
    "estrutura_nome": {
      "type": "string"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "tipo",
    "ativo"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}