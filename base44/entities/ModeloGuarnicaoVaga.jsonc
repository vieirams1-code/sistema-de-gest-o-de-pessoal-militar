{
  "name": "ModeloGuarnicaoVaga",
  "type": "object",
  "title": "Vaga operacional do modelo",
  "description": "Fun\u00e7\u00e3o operacional da guarni\u00e7\u00e3o. Comandante \u00e9 atributo do militar escalado e n\u00e3o uma vaga.",
  "properties": {
    "modelo_guarnicao_id": {
      "type": "string"
    },
    "funcao_operacional": {
      "type": "string",
      "enum": [
        "MOTORISTA",
        "AUXILIAR"
      ]
    },
    "ordem": {
      "type": "integer"
    },
    "obrigatoria": {
      "type": "boolean",
      "default": true
    },
    "requisitos": {
      "type": "string"
    }
  },
  "required": [
    "modelo_guarnicao_id",
    "funcao_operacional",
    "ordem"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}