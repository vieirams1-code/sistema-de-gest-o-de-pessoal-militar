{
  "name": "PermissaoPlanoFerias",
  "type": "object",
  "properties": {
    "plano_ferias_institucional_id": {
      "type": "string",
      "description": "Plano de F\u00e9rias ao qual a permiss\u00e3o pertence."
    },
    "campanha_id": {
      "type": "string",
      "description": "Campanha espec\u00edfica; vazio significa permiss\u00e3o para todo o plano."
    },
    "usuario_id": {
      "type": "string",
      "description": "Usu\u00e1rio do sistema autorizado."
    },
    "usuario_email": {
      "type": "string"
    },
    "usuario_nome": {
      "type": "string"
    },
    "pode_visualizar": {
      "type": "boolean",
      "default": true
    },
    "pode_editar_escala": {
      "type": "boolean",
      "default": false
    },
    "pode_autorizar": {
      "type": "boolean",
      "default": false
    },
    "pode_gerar_ferias": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "plano_ferias_institucional_id",
    "usuario_id",
    "pode_visualizar",
    "pode_editar_escala",
    "pode_autorizar",
    "pode_gerar_ferias",
    "ativo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
